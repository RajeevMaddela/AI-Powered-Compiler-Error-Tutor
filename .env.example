# Backend Configuration
ENV=development
DEBUG=true
PORT=8000
HOST=127.0.0.1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./tutor.db

# Sandbox Configuration
DOCKER_SANDBOX_IMAGE=tutor-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_CONCURRENT=5
SANDBOX_MAX_CODE_BYTES=65536
SANDBOX_MAX_OUTPUT_BYTES=131072

# Frontend Configuration
VITE_API_URL=http://localhost:8000
